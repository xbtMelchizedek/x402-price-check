    "x402",
    "402",
    "payment-required",
    "agents",
    "mcp",
    "llm",
    "inference",
    "price",
    "budget",
    "spend-limit",
    "stablecoin",
    "usdc"
  ],
  "homepage": "https://xbtmelchizedek.github.io/x402-price-check/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xbtMelchizedek/x402-price-check.git"
  },
  "bugs": {
    "url": "https://github.com/xbtMelchizedek/x402-price-check/issues"
  },
  "author": "xbtMelchizedek",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.mjs",
    "./compare": "./src/compare.mjs",
    "./x402": "./src/x402.mjs",
    "./mock": "./src/mock.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "x402-price-check": "src/cli.mjs"
  },
  "files": [
    "src",
